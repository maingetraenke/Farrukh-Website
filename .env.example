# Copy to apps/web/.env.local and fill in with your own Supabase project values.
# Never commit real secrets. See CLAUDE.md rule 4.

# --- Supabase ---
# Project URL and anon key: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the client. Used for admin
# operations (e.g. seed scripts, server-side jobs) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Organization slug/id to scope the app to during local development.
NEXT_PUBLIC_DEFAULT_ORG_ID=

# --- Email (Resend) — Release 1.1 ---
RESEND_API_KEY=
EMAIL_FROM=info@maingetraenke.de

# --- Maps provider — Release 1.1 ---
# One of: google | mapbox
MAPS_PROVIDER=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Card payments — Release 1.1+ (MVP documents payments manually) ---
PAYMENT_PROVIDER_API_KEY=
